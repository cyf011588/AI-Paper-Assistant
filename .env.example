# ============================================================
# AI Paper Assistant — 环境变量模板
#
# 用法：把本文件复制为同目录下的 .env，填入自己的 API Key。
#       .env 已在 .gitignore 中，不会被提交，也不会泄露。
#       config.py 会自动读取它；不填则使用代码里的默认值。
#
# 优先级：.env 中的项 > 系统环境变量 > 代码默认值
#   → 写进 .env 的项一定生效（不会被机器上其他项目的同名变量遮蔽）；
#     没写进 .env 的项才会去读系统环境变量。
# ============================================================

# --- DeepSeek（文献问答 / 检索规划 / 审稿打分）---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 硅基流动 SiliconFlow（问题头脑风暴 / 图片理解）---
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
TEXT_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
VL_MODEL_NAME=Qwen/Qwen3-VL-30B-A3B-Instruct

# --- 可选：HuggingFace 镜像 ---
# HF_ENDPOINT=https://hf-mirror.com

# --- 可选：检索 / 分块参数覆盖（不填就用 config.py 里的默认值）---
# 各方向实验可以只改这里，不用动源码
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=5
# RECALL_K=100
# EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-base
